# PostgreSQL connection. For production, use a managed PostgreSQL provider with pooling.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/paud_lms?schema=public&connection_limit=20&pool_timeout=10"
PORT=4000
WEB_ORIGIN=http://localhost:3000
# Set both values before starting the API. Use a long random secret in production.
ADMIN_USERNAME=guru
ADMIN_PASSWORD=change-me-now
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
COOKIE_SECURE=false
# Optional Redis adapter for multi-instance Socket.io deployments.
REDIS_URL=
